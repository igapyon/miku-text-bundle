{
  "name": "miku-text-bundle",
  "version": "0.5.0",
  "description": "CLI tool to collect repository text files into split Markdown bundles for generative AI handoff.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igapyon/miku-text-bundle.git"
  },
  "homepage": "https://github.com/igapyon/miku-text-bundle#readme",
  "bugs": {
    "url": "https://github.com/igapyon/miku-text-bundle/issues"
  },
  "keywords": [
    "cli",
    "markdown",
    "bundle",
    "ai",
    "repository"
  ],
  "bin": {
    "miku-text-bundle": "./dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist/",
    "README.md",
    "docs/gitignore-limitations.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "scripts": {
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json && node --eval \"import { chmodSync } from 'node:fs'; chmodSync('dist/main.js', 0o755);\" && npm run verify",
    "pack:check": "npm_config_cache=workplace/.npm-cache npm pack --dry-run",
    "verify": "npm test && npm run pack:check",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
